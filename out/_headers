# Long cache for hashed Vite assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Medium cache for branded images
/favicon.svg
  Cache-Control: public, max-age=2592000
/favicon-32.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/og-image.png
  Cache-Control: public, max-age=2592000
/blog-images/*
  Cache-Control: public, max-age=2592000

# Crawler/discovery files — fresh but cacheable, do not index
/sitemap.xml
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: noindex
/feed.xml
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: noindex
/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: noindex
/manifest.webmanifest
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: noindex

# Next.js static export writes a React Server Components payload next to
# every page (/about.txt, /blog/<slug>.txt, ...). The client router fetches
# them on navigation, so they must stay reachable, but they are data dumps,
# not pages: keep them out of the index. Also covers robots.txt, ads.txt,
# llms.txt and the IndexNow key file; noindex does not stop them being read.
/*.txt
  X-Robots-Tag: noindex

# Markdown copies of pages for AI agents (written by scripts/markdown.mjs).
# Not indexed: the HTML page is the canonical version.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  X-Robots-Tag: noindex

# Global security + indexing headers
# No Content-Security-Policy-Report-Only: the ad network (Mediavine, since
# 2026-11-02) loads scripts, frames and beacons from hundreds of bidder
# domains, so an allow-list cannot be kept current and every miss logged a
# console error (Lighthouse Best Practices 73). The enforced policy below sets
# only rules that do not depend on which domains ads load from.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: upgrade-insecure-requests; frame-ancestors 'self'; object-src 'none'; base-uri 'self'

# Next.js build files have content hashes in their names, so they never change
# in place and can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
